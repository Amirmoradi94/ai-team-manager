# Server Configuration
PORT=3001
NODE_ENV=development

# Security - CHANGE THIS IN PRODUCTION
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./taskmanager.db

# CORS - Set to your frontend URL
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Password Security
BCRYPT_ROUNDS=12
MIN_PASSWORD_LENGTH=8

# Email Configuration (Optional - if not set, emails will be logged only)
# For Gmail: host=smtp.gmail.com, port=587, secure=false, user=your-email@gmail.com, password=your-app-password
# For SendGrid: host=smtp.sendgrid.net, port=587, secure=false, user=apikey, password=your-sendgrid-api-key
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@taskmanager.com
EMAIL_FROM_NAME=Task Manager

# Application URL (for email links)
APP_URL=http://localhost:8081

# Admin User (created automatically on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin User
ADMIN_PASSWORD=ChangeThisSecurePassword123!
